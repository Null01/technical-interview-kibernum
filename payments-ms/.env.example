# ──────────────────────────────────────────────────────────────────────────────
# payments-ms — Variables de entorno
# Copiar a .env antes de iniciar en modo desarrollo:
#   cp .env .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Servidor ───────────────────────────────────────────────────────────────────
# Puerto HTTP en el que escucha el servicio
PORT=3003
# Entorno de ejecución: development | production | test
NODE_ENV=development

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Dirección del broker Kafka.
# Desarrollo local: usar el puerto externo 9094 (bitnami KRaft expone dos listeners)
# Docker interno: kafka:9092 (se inyecta vía docker-compose)
KAFKA_BROKER=localhost:9094

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=payments_db
